<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifiesto de la app: la pantalla principal, el receptor de arranque con su servicio en primer
  plano y la actividad invisible que abre las apps cuando el usuario toca el aviso.

  Nunca se declarará el permiso restringido de Google Play que permite consultar todos los
  paquetes instalados (exige una declaración con vídeo en la ficha de la tienda): el selector
  usa <queries> con CATEGORY_LAUNCHER, que devuelve justo las apps lanzables.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Aviso que da el sistema cuando el teléfono termina de arrancar. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Servicio en primer plano que hace el trabajo del arranque. Un receptor de BOOT_COMPLETED solo
      puede levantar estos tipos: location, health, connectedDevice, remoteMessaging, systemExempted
      y specialUse. shortService NO está en esa lista, al contrario de lo que se dio por supuesto al
      escribir esto la primera vez: al declararlo, startForeground() lanzaba
      ForegroundServiceStartNotAllowedException ('FGS type shortService not allowed to start from
      BOOT_COMPLETED!') en Android 16 y 17. Los tipos dataSync, camera, mediaPlayback, phoneCall,
      mediaProjection y microphone tampoco valen. El tipo declarado más abajo es specialUse, que a
      diferencia de shortService exige su propio permiso además de este general.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Permiso propio del tipo specialUse (Android 14 o superior). No sustituye al anterior. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Ventanas superpuestas: es la vía del modo automático. El usuario lo concede a mano en los
         ajustes del sistema y la app lo comprueba en tiempo de ejecución antes de usarlo. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Aviso de arranque en Android 13 o superior: sin este permiso no se puede avisar al usuario,
         y con el modo automático apagado la app no tendría forma de hacerlo. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BootLink">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BootLink">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Actividad sin interfaz del modo de notificación: el PendingIntent del aviso abre esta
          actividad y, ya con ventana visible, abre las apps configuradas y se cierra sola.
          - exported="false": solo la puede abrir el propio BootLink (el PendingIntent lo crea la
            app, así que el sistema lo lanza con su identidad).
          - excludeFromRecents + noHistory: no aparece en el historial de tareas ni queda en
            segundo plano; se cierra antes de que se vea.
          - taskAffinity="": no se mezcla con la tarea de la pantalla principal.
          - Tema translúcido: no dibuja nada, así no tapa lo que el usuario tenía delante.
        -->
        <activity
            android:name=".arranque.LanzadorActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.BootLink.Lanzador" />

        <!--
          Receptor del arranque del teléfono. Atiende las tres acciones que usan los fabricantes:
          BOOT_COMPLETED (el arranque normal), LOCKED_BOOT_COMPLETED (antes de desbloquear, que
          exige directBootAware para que el sistema lo entregue) y QUICKBOOT_POWERON (el reinicio
          rápido de algunos fabricantes, que es el único aviso que envían). Es exported porque lo
          llama el sistema, pero las tres acciones son protegidas: solo el sistema puede enviarlas.
        -->
        <receiver
            android:name=".arranque.ReceptorArranque"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!--
          Servicio en primer plano que lee la configuración y lanza las apps. Es specialUse: el tipo
          que Android 16/17 sí permite levantar desde un receptor de BOOT_COMPLETED y que, a
          diferencia de shortService, no tiene límite de tiempo (se cierra él mismo en cuanto
          termina). La <property> de abajo es la justificación que specialUse obliga a declarar:
          Google Play la revisa al publicar, pero no bloquea la instalación directa del APK. No se
          exporta: solo lo arranca el receptor de la propia app.
        -->
        <service
            android:name=".arranque.ServicioArranque"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Abre las aplicaciones que el usuario ha elegido justo después de que el teléfono termine de arrancar." />
        </service>
    </application>

    <!--
      Bloque <queries> en lugar del permiso restringido de Google Play que permite consultar
      todos los paquetes instalados. Con la acción MAIN y la categoría LAUNCHER,
      PackageManager.queryIntentActivities() devuelve exactamente las apps que tienen icono en
      el menú de aplicaciones: justo las que ofrece el selector.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

</manifest>
