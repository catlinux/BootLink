<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Tema de la ventana, el que Android usa antes de que Compose dibuje su primera
      imagen. Sin barra de acción, porque toda la interfaz la pone Compose con Material 3.
      La variante oscura está en values-night/themes.xml.
    -->
    <style name="Theme.BootLink" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
      Tema de LanzadorActivity, la actividad sin interfaz que abre las apps cuando el usuario
      toca el aviso de arranque. Es translúcida para que no se vea ningún parpadeo sobre lo que
      hubiera en pantalla, y no hereda del tema de la app porque esa actividad no usa Compose.
    -->
    <style name="Theme.BootLink.Lanzador" parent="@android:style/Theme.Translucent.NoTitleBar" />

    <!--
      Tema de ConfirmacionActivity, la actividad del modo de confirmación. También es translúcida,
      pero por otro motivo: aquí sí hay interfaz (Compose), y lo que se ve es el diálogo de Material
      3 centrado, sin fondo de pantalla completa detrás. Así queda claro que hay una pregunta
      esperando respuesta y no parece que la app haya ocupado la pantalla.
      La variante oscura no hace falta: el diálogo toma sus colores del tema de Compose, que ya
      sigue el modo oscuro del sistema.
    -->
    <style name="Theme.BootLink.Dialogo" parent="@android:style/Theme.Translucent.NoTitleBar" />

</resources>
