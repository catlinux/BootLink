    <string name="lista_vacia_descripcion">Aquí aparecerá la lista de aplicaciones que BootLink lanzará al arrancar el teléfono.</string>
    <string name="lista_anadir">Añadir aplicación</string>
    <string name="lista_subir">Subir</string>
    <string name="lista_bajar">Bajar</string>
    <string name="lista_quitar">Quitar</string>
    <string name="lista_retardo_etiqueta">Retardo (ms)</string>
