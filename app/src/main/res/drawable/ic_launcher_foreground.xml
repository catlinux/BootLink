<?xml version="1.0" encoding="utf-8"?>
<!--
  Capa de primer plano del icono adaptativo de BootLink: el rayo blanco del símbolo de la app, el
  mismo de las notificaciones (ic_aviso_arranque), sobre tres cuadrados redondeados translúcidos
  que son las apps que el rayo enciende al arrancar el teléfono.

  Mide 108x108dp, como la capa de fondo, pero todo el dibujo se queda dentro del cuadrado central
  de 72x72dp (de 18,18 a 90,90): el lanzador puede recortar fuera de esa zona segura, así que ahí
  fuera no hay nada que merezca la pena ver. El rayo va el último para quedar por delante de los
  cuadrados, y los cuadrados son blancos con un 25% de opacidad para que se vean como un fondo
  suave del rayo.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Cuadrado de arriba a la izquierda: de (22,23) a (44,45), con 6 de radio. -->
    <path
        android:fillColor="#40FFFFFF"
        android:pathData="M28,23l10,0a6,6 0 0 1 6,6l0,10a6,6 0 0 1 -6,6l-10,0a6,6 0 0 1 -6,-6l0,-10a6,6 0 0 1 6,-6z" />

    <!-- Cuadrado de arriba a la derecha: de (64,23) a (86,45). -->
    <path
        android:fillColor="#40FFFFFF"
        android:pathData="M70,23l10,0a6,6 0 0 1 6,6l0,10a6,6 0 0 1 -6,6l-10,0a6,6 0 0 1 -6,-6l0,-10a6,6 0 0 1 6,-6z" />

    <!-- Cuadrado de abajo, en el centro: de (43,63) a (65,85). -->
    <path
        android:fillColor="#40FFFFFF"
        android:pathData="M49,63l10,0a6,6 0 0 1 6,6l0,10a6,6 0 0 1 -6,6l-10,0a6,6 0 0 1 -6,-6l0,-10a6,6 0 0 1 6,-6z" />

    <!--
      El rayo, dibujado en su espacio de 24x24 de siempre y ampliado por 2.5 hasta los 45dp de alto
      del icono (de 31.5 a 76.5), centrado en el lienzo: su silueta va de 7.0 a 17.0 en horizontal y
      de 3 a 21 en vertical, o sea que su centro (12, 12) cae en 2.5 x 12 + 24 = 54, justo el centro
      del lienzo de 108. Lleva un contorno apenas más claro que el relleno.
    -->
    <group
        android:scaleX="2.5"
        android:scaleY="2.5"
        android:translateX="24"
        android:translateY="24">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M11,21h-1l1,-7H7.5c-0.58,0 -0.57,-0.32 -0.38,-0.66c0.19,-0.34 0.05,-0.08 0.07,-0.12C8.48,10.94 10.42,7.54 13,3h1l-1,7h3.5c0.49,0 0.56,0.33 0.47,0.51l-0.07,0.15C12.96,17.55 11,21 11,21z"
            android:strokeColor="#FFE6DEFF"
            android:strokeWidth="0.6" />
    </group>
</vector>
